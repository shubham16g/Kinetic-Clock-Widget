<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/background">

        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            app:defaultValue="true"
            app:key="showBackground"
            app:title="@string/show_background" />



        <ListPreference
            app:dependency="showBackground"
            app:defaultValue="solid_color"
            app:entries="@array/reply_entries"
            app:entryValues="@array/reply_values"
            app:iconSpaceReserved="false"
            app:key="backgroundType"
            app:title="Background Type"
            app:useSimpleSummaryProvider="true" />


        <com.kizitonwose.colorpreferencecompat.ColorPreferenceCompat
            app:defaultValue="@color/white"
            app:key="bgColor"
            app:colorChoices="@array/colors_array"
            app:iconSpaceReserved="false"
            app:dependency="showBackground"
            app:title="Background Color"/>
        <SeekBarPreference
            app:key="bgOpacity"
            app:iconSpaceReserved="false"
            app:dependency="showBackground"
            app:defaultValue="100"
            app:title="Background Opacity"/>

    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/clocks">

        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            app:key="showClocks"
            app:defaultValue="true"
            app:title="@string/show_clocks" />

        <SeekBarPreference
            app:key="clocksOpacity"
            app:iconSpaceReserved="false"
            app:dependency="showClocks"
            app:defaultValue="40"
            app:title="Clocks Opacity"/>

    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/pins">

        <com.kizitonwose.colorpreferencecompat.ColorPreferenceCompat
            app:key="pinsColor"
            app:colorChoices="@array/colors_array"
            app:iconSpaceReserved="false"
            app:defaultValue="@color/black"
            app:title="Pins Color"/>

    </PreferenceCategory>

</PreferenceScreen>