<?xml version="1.0" encoding="utf-8"?>
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:configure="com.shubhamgupta16.advancedwidget.SettingsActivity"
    android:widgetFeatures="reconfigurable"
    android:minWidth="120dp"
    android:minHeight="180dp"
    android:minResizeWidth="120dp"
    android:minResizeHeight="180dp"
    android:updatePeriodMillis="86400000"
    android:previewImage="@drawable/multi_clock_thumb"
    android:description="@string/widget_vertical_description"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:targetCellHeight="3"
    android:targetCellWidth="2"
    android:initialLayout="@layout/test_widget"
    android:initialKeyguardLayout="@layout/test_widget"
    tools:ignore="UnusedAttribute" />
