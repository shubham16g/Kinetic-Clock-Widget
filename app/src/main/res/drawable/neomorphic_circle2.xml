<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base circle -->

    
    <!-- Inset shadow - dark at top -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#25000000"
                android:centerColor="#10000000"
                android:endColor="#00000000"
                android:centerY="0.3" />
        </shape>
    </item>
    
    <!-- Inset highlight - light at bottom -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#25FFFFFF"
                android:centerColor="#10FFFFFF"
                android:endColor="#00FFFFFF"
                android:centerY="0.7" />
        </shape>
    </item>
</layer-list>