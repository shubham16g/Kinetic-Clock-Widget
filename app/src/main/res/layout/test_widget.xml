<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.AdvancedWidget.AppWidget.Container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/Theme.AdvancedWidget.AppWidgetContainer"
    android:background="@android:color/transparent">

    <TextView
        android:id="@+id/testText"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:textColor="@color/black"
        android:layout_centerInParent="true"
        android:textSize="20sp"
        android:gravity="center"
        android:background="#50ffffff"
        android:padding="5dp"
        android:text="@string/wait_automatically"/>

    <ImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/clock_image_desc" />
</RelativeLayout>